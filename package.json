{
  "name": "opentv",
  "productName": "OpenTV",
  "version": "2.0.0-alpha.1",
  "description": "OpenTV v2 — Tauri v2 + React/TS (PC) + Kotlin nativo (Android y TV) + Núcleo unificado Rust",
  "author": "TECHPOINT Software™",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "node scripts/run-tauri.cjs dev",
    "dev:pc": "node scripts/run-tauri.cjs dev",
    "preview:pc": "node scripts/run-tauri.cjs preview",
    "build:ui": "npm --prefix apps/desktop/frontend run build",
    "build:pc": "node scripts/run-tauri.cjs build",
    "build:rust:android": "node scripts/build-rust-android.cjs",
    "build:android": "node scripts/build-android.cjs",
    "build:service": "node scripts/build-service.cjs",
    "test:frontend": "npm --prefix apps/desktop/frontend test",
    "test:rust": "cargo test --manifest-path core/Cargo.toml",
    "test:service": "node --test tests/core.test.cjs",
    "test:android": "node scripts/build-android.cjs --test-only",
    "test:e2e": "node --test tests/e2e-pc.test.cjs",
    "test": "npm run test:frontend && npm run test:rust && npm run test:service",
    "test:all": "npm test && npm run test:android && npm run test:e2e"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6"
  }
}
