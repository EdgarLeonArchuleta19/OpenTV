{
  "name": "opentv",
  "productName": "OpenTV",
  "version": "1.0.0",
  "description": "OpenTV Desktop — Reproductor de TV en vivo, películas y series para Windows",
  "author": "TECHPOINT Software™",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.cjs -i ui/desktop/tw/input.css -o ui/desktop/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.cjs -i ui/desktop/tw/input.css -o ui/desktop/tailwind.css --watch",
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win nsis portable",
    "dist:portable": "electron-builder --win portable",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1",
    "predist": "npm run build",
    "predist:portable": "npm run build",
    "build:js": "node scripts/build-app.cjs",
    "check:js": "node scripts/build-app.cjs --check",
    "build": "npm run build:js && npm run build:css",
    "prestart": "npm run build:js",
    "predev": "npm run build:js",
    "test": "node --test \"tests/*.test.cjs\"",
    "test:e2e": "node tests/e2e/run.cjs",
    "snapshot": "node scripts/snapshot-catalog.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "hls.js": "^1.5.20"
  },
  "devDependencies": {
    "acorn": "^8.15.0",
    "electron": "^44.10.2",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^3.4.17"
  },
  "build": {
    "appId": "com.techpoint.opentv",
    "productName": "OpenTV",
    "copyright": "Copyright © 2026 TECHPOINT Software™",
    "electronDist": "node_modules/electron/dist",
    "electronVersion": "44.10.2",
    "asar": false,
    "files": [
      "desktop/**/*",
      "service/**/*",
      "ui/**/*",
      "bin/**/*",
      "licenses/**/*",
      "LICENSE",
      "README.md",
      "package.json",
      "!ui/desktop/tw/**",
      "!ui/assets/*.bak",
      "!ui/js/src/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "ui/images/icon-large.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenTV",
      "artifactName": "OpenTV Setup ${version}.exe"
    },
    "portable": {
      "artifactName": "OpenTV Portable ${version}.exe"
    }
  }
}
