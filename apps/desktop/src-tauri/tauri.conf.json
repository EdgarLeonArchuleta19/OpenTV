{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenTV",
  "version": "2.0.0",
  "identifier": "com.techpoint.opentv",
  "build": {
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../frontend"
    },
    "frontendDist": "../dist-ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/bin/ffmpeg.exe": "resources/bin/ffmpeg.exe",
      "../../../licenses/*": "licenses/",
      "../../../LICENSE": "LICENSE"
    },
    "publisher": "TECHPOINT Software",
    "copyright": "Copyright © 2026 TECHPOINT Software",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerHooks": "./installer_hooks.nsh"
      }
    }
  }
}
